EnumerateLatticeGroupBFS := function(gens)
    local elements, seen, head, g, h, key, gen, out, i;

    elements := [IdentityMat(Length(gens[1]))];
    seen := NewDictionary(
        Concatenation(elements[1]) mod 3, true
    );
    AddDictionary(
        seen, Concatenation(elements[1]) mod 3, 1
    );

    head := 1;
    while head <= Length(elements) do
        g := elements[head];

        for gen in gens do
            h := g * gen;
            key := Concatenation(h) mod 3;

            if LookupDictionary(seen, key) = fail then
                Add(elements, h);
                AddDictionary(seen, key, Length(elements));
            fi;
        od;

        head := head + 1;
    od;

    if Length(elements) <> 11520 then
        Error("Expected 11520 elements, found ", Length(elements));
    fi;

    return elements;
end;;

allElements11520 := EnumerateLatticeGroupBFS(
    [g1, g2, g3, g4]
);;

orthorec.autgens:=[g1, g2, g3, g4];
orthorec.allgs:=allElements11520;

savedataas(orthorec, "sublat180rec");

readdata("sublat180rec");

tGramS:=DiagonalMats([[[8]], -sublat180rec.Gram]);
tdiscrec:=DiscriminantForm(tGramS);
periodcond:=[IdentityMat(2), DiagonalMat(List(tdiscrec.discg, xx->xx-1))];

geomauts:=[];


for tg in sublat180rec.allgs do 
  ttg:=DiagonalMats([[[1]], tg]);
  tqg:=OLtoOqL(ttg, tdiscrec);
  if tqg in periodcond then 
    Add(geomauts, tg);
  fi;
od;

Printn(Length(geomauts));